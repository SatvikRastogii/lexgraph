# Virtual environments
graphrag-env/
venv/
env/
.venv/

# GraphRAG build artifacts (regenerable; gigabytes)
output/
cache/
logs/
*.parquet
*.log

# Vector store (device-specific, regenerable via scripts/build_index.py)
chroma_db/

# Secrets
.env
.env.*
!.env.example

# Raw scrape output. input/ is tracked deliberately: it is the curated
# 40-judgment subset the published benchmark runs against.
legal_corpus/

# Evaluation run artifacts (results are summarised in reports/, not committed raw)
eval_runs/

# Cached LLM responses (regenerable; LEXGRAPH_CACHE=off disables)
.llm_cache/

# Personal documents that happen to live in the working directory. This
# repository is public; a CV carries a phone number and address.
*Resume*.pdf
*resume*.pdf
*CV*.pdf

# Editor / tooling
.idea/
.vscode/
.claude/
.agents/
CLAUDE.md

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
