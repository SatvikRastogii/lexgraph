# Virtual environments
graphrag-env/
venv/
env/
.venv/

# GraphRAG build artifacts. The parquets are the exception: they are 5.5MB
# total, they take hours of LLM extraction to regenerate, and the deployed app
# reads them directly for the graph, timeline and analytics views. Everything
# else here (LanceDB stores, caches, our own embedding npz) is regenerable in
# minutes and stays out.
#
# `output/*` rather than `output/`, because git cannot re-include a file whose
# parent directory is excluded.
output/*
!output/*.parquet
cache/
logs/
*.log

# Vector store (device-specific, regenerable via scripts/build_index.py)
chroma_db/

# Secrets
.env
.env.*
!.env.example

# Raw scrape output. input/ is tracked deliberately: it is the curated
# 40-judgment subset the published benchmark runs against.
legal_corpus/

# Evaluation run artifacts (results are summarised in reports/, not committed raw)
eval_runs/

# Cached LLM responses (regenerable; LEXGRAPH_CACHE=off disables)
.llm_cache/

# Personal documents that happen to live in the working directory. This
# repository is public; a CV carries a phone number and address.
*Resume*.pdf
*resume*.pdf
*CV*.pdf

# Editor / tooling
.idea/
.vscode/
.claude/
.agents/
CLAUDE.md

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
