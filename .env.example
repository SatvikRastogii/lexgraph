# Copy to .env and fill in. .env is gitignored.

# Where the local generator and embedding model run.
OLLAMA_HOST=http://localhost:11434

# Judge model key. The judge MUST be a different model from the generator --
# scoring llama3.1's answers with llama3.1 is self-evaluation and the
# evaluation refuses to run that way.
#
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Alternatives, all supported by lexgraph/llm.py. Any one of these is enough.
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# GraphRAG reads this from settings.yaml; Ollama ignores the value.
GRAPHRAG_API_KEY=ollama
