{
  "title": "LexGraph Ops",
  "uid": "lexgraph-ops",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Ollama Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "probe_success{job=\"ollama-health\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Query Failure Rate (last 50)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "lexgraph_failure_rate", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "title": "GPU Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "nvidia_smi_utilization_gpu_ratio", "legendFormat": "GPU util", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "GPU Memory Used (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "nvidia_smi_memory_used_bytes", "legendFormat": "VRAM used", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Host CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Query Volume by Route (rate, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "sum(rate(lexgraph_queries_total[5m])) by (route)", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Latest Pipeline Latency by Route (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "lexgraph_query_latency_ms", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "RAGAS Drift — Score by Metric/Pipeline",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "lexgraph_ragas_score", "legendFormat": "{{metric}} / {{pipeline}}", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "title": "RAGAS Drift Flags",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "lexgraph-prometheus" },
      "targets": [
        { "expr": "sum(lexgraph_ragas_drift_detected)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 1, "color": "red" } ] }
        }
      }
    }
  ]
}
